---
import Layout from '../layouts/Layout.astro';

const clients = ['GetSmarter', 'Betway', 'Universal Robots', 'Surfshark'];

const stats = [
  { value: '250K+', label: 'Websites in our outreach network' },
  { value: '35+', label: 'Countries we operate in' },
  { value: '20+', label: 'In-house specialists' },
  { value: '2018', label: 'Founded, still fully remote' },
];

const services = [
  {
    name: 'Link Building',
    description:
      'Editorial backlinks earned through a vetted network spanning Europe, Latin America, APAC and North America — no expired domains, no link farms.',
    href: '/services/link-building',
  },
  {
    name: 'Digital PR',
    description:
      'Earned coverage that builds authority and drives organic traffic in one motion, rather than treating press and SEO as separate budgets.',
    href: '/services/digital-pr',
  },
  {
    name: 'SEO',
    description:
      'Search programmes built for regulated, competitive niches — iGaming, crypto, SaaS, healthcare — where generic playbooks fall short.',
    href: '/services/seo',
  },
  {
    name: 'Agency Partnerships',
    description:
      'White-label link building and outreach for agencies who need reach beyond their current market without hiring for it.',
    href: '/services/agency-partnerships',
  },
];

const testimonials = [
  {
    quote:
      'AWISEE moved our organic traffic in ways previous agencies never managed.',
    name: 'Priya Nair',
    role: 'Head of SEO, GetSmarter',
  },
  {
    quote: 'Six months in, referral domains and organic leads had roughly doubled.',
    name: 'Elena Kowalski',
    role: 'VP Marketing, Surfshark',
  },
];
---

<Layout
  title="International Link Building & SEO Agency"
  description="AWISEE is a link building, SEO and digital PR agency working across 35+ countries with a network of 250,000+ vetted websites."
>
  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pt-20 pb-24 lg:px-8 lg:pt-28 lg:pb-32">
    <div class="mx-auto max-w-4xl text-center">
      <p class="animate-fade-up inline-flex items-center gap-2 rounded-full border border-ink/10 bg-accent px-4 py-1.5 text-xs font-semibold tracking-wide text-accent-ink uppercase dark:border-transparent">
        Link Building · SEO · Digital PR · Influencer Marketing
      </p>
      <h1 class="animate-fade-up mt-6 font-display text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl" style="animation-delay: 80ms">
        Earn the links your <span class="text-brand-500">rankings</span> actually deserve.
      </h1>
      <p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg text-ink/70 dark:text-paper/70" style="animation-delay: 160ms">
        AWISEE is the link building, SEO and digital PR partner for brands competing in unforgiving niches — backed by a vetted network of 250,000+ sites across 35 countries.
      </p>
      <div class="animate-fade-up mt-10 flex flex-wrap items-center justify-center gap-4" style="animation-delay: 240ms">
        <a
          href="/contact"
          class="rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-paper transition-transform hover:-translate-y-0.5 dark:bg-paper dark:text-ink"
        >
          Book an intro call
        </a>
        <a
          href="/case-studies"
          class="rounded-full border border-ink/15 px-7 py-3.5 text-sm font-semibold transition-colors hover:border-ink/30 dark:border-paper/20 dark:hover:border-paper/40"
        >
          See our work
        </a>
      </div>
    </div>
  </section>

  <!-- Client logos -->
  <section class="border-y border-ink/10 bg-paper-dim px-6 py-12 dark:border-paper/10 dark:bg-ink-soft lg:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-center text-xs font-medium tracking-wide text-ink/50 uppercase dark:text-paper/50">
        Trusted by ambitious brands in unforgiving markets
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-12 gap-y-4" data-reveal-group>
        {clients.map((client) => (
          <span class="font-display text-xl font-semibold text-ink/60 dark:text-paper/60">{client}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bento -->
  <section class="px-6 py-24 lg:px-8">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-4 lg:grid-cols-4" data-reveal-group>
      {stats.map((stat) => (
        <div class="rounded-3xl border border-ink/10 bg-paper-dim p-8 transition-colors hover:border-brand-400/50 dark:border-paper/10 dark:bg-ink-soft">
          <p class="font-display text-4xl font-bold text-brand-600 dark:text-brand-300">{stat.value}</p>
          <p class="mt-2 text-sm text-ink/60 dark:text-paper/60">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Services -->
  <section class="px-6 py-8 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
          One team, full funnel.
        </h2>
        <p class="mt-4 text-ink/70 dark:text-paper/70">
          Link building, digital PR, SEO and influencer marketing under one roof — integrated rather than run as silos, so nothing gets lost in a handoff between agencies.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2" data-reveal-group>
        {services.map((service) => (
          <a
            href={service.href}
            class="group rounded-3xl border border-ink/10 p-8 transition-colors hover:border-brand-400/50 hover:bg-brand-50 dark:border-paper/10 dark:hover:bg-brand-900/20"
          >
            <h3 class="font-display text-xl font-semibold">{service.name}</h3>
            <p class="mt-3 text-sm text-ink/60 dark:text-paper/60">{service.description}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-600 transition-transform group-hover:translate-x-1 dark:text-brand-300">
              Learn more →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder quote -->
  <section class="px-6 py-24 lg:px-8">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="font-display text-2xl font-medium text-balance sm:text-3xl">
        "We didn't set out to build an agency. We set out to get one client real results — everything since has followed from that."
      </p>
      <p class="mt-6 text-sm font-semibold text-ink/60 dark:text-paper/60">
        Gustavo Andersson, CEO &amp; Founder
      </p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="border-t border-ink/10 bg-paper-dim px-6 py-24 dark:border-paper/10 dark:bg-ink-soft lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2" data-reveal-group>
      {testimonials.map((t) => (
        <figure class="rounded-3xl border border-ink/10 bg-paper p-8 dark:border-paper/10 dark:bg-ink">
          <blockquote class="text-lg font-medium text-balance">"{t.quote}"</blockquote>
          <figcaption class="mt-4 text-sm text-ink/60 dark:text-paper/60">
            {t.name} · {t.role}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="px-6 py-24 lg:px-8">
    <div class="mx-auto max-w-3xl rounded-3xl bg-ink px-8 py-16 text-center dark:bg-paper" data-reveal>
      <h2 class="font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl dark:text-ink">
        Ready when you are.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-paper/70 dark:text-ink/70">
        Book a call and we'll tell you, plainly, whether we're the right fit — no discovery-call theatre.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-block rounded-full bg-paper px-7 py-3.5 text-sm font-semibold text-ink transition-transform hover:-translate-y-0.5 dark:bg-ink dark:text-paper"
      >
        Book an intro call
      </a>
    </div>
  </section>
</Layout>
