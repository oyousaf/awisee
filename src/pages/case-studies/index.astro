---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CaseStudyFilter from '../../components/CaseStudyFilter.tsx';

const caseStudies = (await getCollection('caseStudies'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .map((entry) => ({
    slug: entry.id,
    ...entry.data,
  }));
---

<Layout
  title="Case Studies"
  description="Results from AWISEE's link building, SEO, digital PR and agency partnership engagements."
>
  <section class="px-6 pt-20 pb-16 lg:px-8 lg:pt-28">
    <div class="mx-auto max-w-3xl text-center">
      <p class="animate-fade-up inline-flex items-center gap-2 rounded-full bg-accent px-4 py-1.5 text-xs font-semibold tracking-wide text-accent-ink uppercase">
        Case Studies
      </p>
      <h1 class="animate-fade-up mt-6 font-display text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl" style="animation-delay: 80ms">
        Results, not vibes.
      </h1>
      <p class="animate-fade-up mx-auto mt-6 max-w-xl text-lg text-ink/70 dark:text-paper/70" style="animation-delay: 160ms">
        A sample of engagements across our core services. Filter by discipline to see what's relevant to you.
      </p>
    </div>
  </section>

  <section class="px-6 pb-24 lg:px-8">
    <div class="mx-auto max-w-5xl" data-reveal>
      <CaseStudyFilter caseStudies={caseStudies} client:visible />
    </div>
  </section>
</Layout>
