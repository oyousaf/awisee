---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AWISEE',
  url: Astro.site?.toString(),
  logo: new URL('/favicon.svg', Astro.site).toString(),
  foundingDate: '2018',
  email: 'b2b@awisee.com',
  description:
    'AWISEE is a link building, SEO, digital PR and influencer marketing agency operating across 35+ countries.',
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} · AWISEE</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · AWISEE`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="AWISEE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · AWISEE`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500..700&family=Inter:wght@400..600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('awisee-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = stored ?? (prefersDark ? 'dark' : 'light');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>

    <ClientRouter />
  </head>
  <body class="font-body antialiased selection:bg-brand-500">
    <Header transition:persist />
    <main transition:animate="fade">
      <slot />
    </main>
    <Footer transition:persist />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
