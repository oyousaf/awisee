---
const serviceLinks = [
  { label: 'Link Building', href: '/services/link-building' },
  { label: 'Digital PR', href: '/services/digital-pr' },
  { label: 'SEO', href: '/services/seo' },
  { label: 'Influencer Marketing', href: '/services/influencer-marketing' },
  { label: 'Agency Partnerships', href: '/services/agency-partnerships' },
];

const companyLinks = [
  { label: 'About', href: '/about' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Blog', href: '/blog' },
  { label: 'Careers', href: '/careers' },
  { label: 'Contact', href: '/contact' },
];

const legalLinks = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Cookies', href: '/cookies' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-paper dark:border-paper/10 dark:bg-ink">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <p class="font-display text-xl font-bold tracking-tight">AWISEE<span class="text-accent">.</span></p>
        <p class="mt-3 max-w-xs text-sm text-ink/60 dark:text-paper/60">
          The people behind your link building, SEO and PR programme. Working across 35+ countries since 2018.
        </p>
      </div>

      <div>
        <p class="text-sm font-semibold">Services</p>
        <ul class="mt-4 space-y-2.5">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink/60 hover:text-ink dark:text-paper/60 dark:hover:text-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold">Company</p>
        <ul class="mt-4 space-y-2.5">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink/60 hover:text-ink dark:text-paper/60 dark:hover:text-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold">Legal</p>
        <ul class="mt-4 space-y-2.5">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink/60 hover:text-ink dark:text-paper/60 dark:hover:text-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-ink/10 pt-8 text-xs text-ink/50 dark:border-paper/10 dark:text-paper/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} AWISEE. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="mailto:b2b@awisee.com" class="hover:text-ink dark:hover:text-paper">Email</a>
        <a href="https://t.me/awiseeagency" class="hover:text-ink dark:hover:text-paper">Telegram</a>
        <a href="https://wa.me/46735716250" class="hover:text-ink dark:hover:text-paper">WhatsApp</a>
      </div>
    </div>
  </div>
</footer>
