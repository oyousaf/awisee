---
interface Step {
  title: string;
  body: string;
}

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  steps: Step[];
  faqs: FAQ[];
}

const { eyebrow, title, intro, steps, faqs } = Astro.props;
---

<section class="px-6 pt-20 pb-16 lg:px-8 lg:pt-28">
  <div class="mx-auto max-w-3xl text-center">
    <p class="animate-fade-up inline-flex items-center gap-2 rounded-full bg-accent px-4 py-1.5 text-xs font-semibold tracking-wide text-accent-ink uppercase">
      {eyebrow}
    </p>
    <h1 class="animate-fade-up mt-6 font-display text-4xl font-bold tracking-tight text-balance sm:text-5xl lg:text-6xl" style="animation-delay: 80ms">
      {title}
    </h1>
    <p class="animate-fade-up mx-auto mt-6 max-w-xl text-lg text-ink/70 dark:text-paper/70" style="animation-delay: 160ms">
      {intro}
    </p>
    <div class="animate-fade-up mt-10 flex flex-wrap items-center justify-center gap-4" style="animation-delay: 240ms">
      <a
        href="/contact"
        class="rounded-full bg-ink px-7 py-3.5 text-sm font-semibold text-paper transition-transform hover:-translate-y-0.5 dark:bg-paper dark:text-ink"
      >
        Book an intro call
      </a>
      <a
        href="/services"
        class="rounded-full border border-ink/15 px-7 py-3.5 text-sm font-semibold transition-colors hover:border-ink/30 dark:border-paper/20 dark:hover:border-paper/40"
      >
        All services
      </a>
    </div>
  </div>
</section>

<section class="border-t border-ink/10 bg-paper-dim px-6 py-24 dark:border-paper/10 dark:bg-ink-soft lg:px-8">
  <div class="mx-auto max-w-4xl">
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">How it works</h2>
    <ol class="mt-12 space-y-6" data-reveal-group>
      {steps.map((step, i) => (
        <li class="flex gap-6 rounded-3xl border border-ink/10 bg-paper p-8 dark:border-paper/10 dark:bg-ink">
          <span class="font-display text-2xl font-bold text-brand-500">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="font-display text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-ink/60 dark:text-paper/60">{step.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="px-6 py-24 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Frequently asked</h2>
    <div class="mt-10 space-y-4" data-reveal-group>
      {faqs.map((faq) => (
        <details class="group rounded-2xl border border-ink/10 p-6 dark:border-paper/10">
          <summary class="flex cursor-pointer list-none items-center justify-between font-medium">
            {faq.question}
            <span class="ml-4 shrink-0 text-brand-500 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-sm text-ink/60 dark:text-paper/60">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="px-6 pb-24 lg:px-8">
  <div class="mx-auto max-w-3xl rounded-3xl bg-ink px-8 py-16 text-center dark:bg-paper" data-reveal>
    <h2 class="font-display text-3xl font-bold tracking-tight text-paper sm:text-4xl dark:text-ink">
      Ready when you are.
    </h2>
    <a
      href="/contact"
      class="mt-8 inline-block rounded-full bg-paper px-7 py-3.5 text-sm font-semibold text-ink transition-transform hover:-translate-y-0.5 dark:bg-ink dark:text-paper"
    >
      Book an intro call
    </a>
  </div>
</section>
